PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=secure_grievance_db

# Security & Tokens
JWT_SECRET=your_jwt_secret_key_replace_in_production
JWT_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
